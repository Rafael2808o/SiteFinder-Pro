# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# As chaves abaixo NÃO vão no frontend. Configure-as como secrets das
# Supabase Edge Functions (nunca em um arquivo .env do Vite):
#
#   supabase secrets set AI_PROVIDER=gemini
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=gemini-flash-latest   # opcional
#
# Para usar OpenAI em vez de Gemini: AI_PROVIDER=openai + OPENAI_API_KEY.
#
# Busca de empresas (places-search) usa OpenStreetMap — sem key, sem secret.
